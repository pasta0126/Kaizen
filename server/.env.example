# Copy to server/.env on void-server (git-ignored). No "$" in values, or
# escape as "$$" (Docker Compose interpolates env_file values).

# From ~/infra/platform/.env -> KAIZEN_DB_PASSWORD
DATABASE_URL=postgres://kaizen_app:REPLACE_WITH_KAIZEN_DB_PASSWORD@postgres:5432/kaizen

# From ~/infra/platform/.env -> PLATFORM_JWT_SECRET (exact same value)
JWT_SECRET=REPLACE_WITH_PLATFORM_JWT_SECRET

JWT_ISSUER=https://auth.northernarchive.com/auth/v1
JWT_AUDIENCE=authenticated
JWT_VERIFY_ISSUER=true
